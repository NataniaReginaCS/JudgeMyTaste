@model IEnumerable<JudgeMyTaste.Models.Musik>

@{
    ViewData["Title"] = "Musik";
    var total = Model.Count();
    var sheetName = ViewData["SheetName"] as string ?? "Musik";
    var columns = ViewData["Columns"] as string[] ?? Array.Empty<string>();
    var importErrors = TempData["ImportErrors"] as string;
    var importSuccess = TempData["ImportSuccess"] as string;
    var no = 1;
}

<style>
    .dropzone {
        border: 2px dashed var(--bs-border-color);
        border-radius: .75rem;
        padding: 1.75rem 1rem;
        text-align: center;
        cursor: pointer;
        background: var(--bs-tertiary-bg, #f8f9fa);
        transition: border-color .15s, background-color .15s;
    }
    .dropzone:hover,
    .dropzone:focus-visible,
    .dropzone.dragover {
        border-color: var(--bs-primary);
        background: rgba(13, 110, 253, .08);
        outline: none;
    }
    .dropzone .dz-title { font-weight: 600; }
    .table-wrap { max-height: 420px; overflow-y: auto; }
    .table-wrap thead th { position: sticky; top: 0; background: var(--bs-body-bg); z-index: 1; }
</style>

<div class="mb-4">
    <h1 class="h2 mb-1">Musik</h1>
    <p class="text-muted mb-0">Import dan export data lagu lewat file Excel (.xlsx).</p>
</div>

@if (!string.IsNullOrEmpty(importSuccess))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @importSuccess
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
    </div>
}

<div class="row g-3 mb-4">
    <!-- EXPORT -->
    <div class="col-lg-5">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Export ke Excel</h2>
                <p class="text-muted">
                    Unduh semua data lagu yang ada di database
                    (<strong>@total</strong> data) sebagai file .xlsx.
                </p>
                <div class="mt-auto d-flex flex-wrap gap-2">
                    <a asp-action="Export" class="btn btn-success @(total == 0 ? "disabled" : "")"
                       aria-disabled="@(total == 0 ? "true" : "false")">Export data</a>
                    <a asp-action="Template" class="btn btn-outline-secondary">Unduh template</a>
                </div>
            </div>
        </div>
    </div>

    <!-- IMPORT -->
    <div class="col-lg-7">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title">Import dari Excel</h2>

                <form id="importForm" asp-action="Import" method="post" enctype="multipart/form-data">
                    <div id="dropzone" class="dropzone mb-2" tabindex="0" role="button"
                         aria-label="Pilih atau jatuhkan file Excel di sini">
                        <div class="dz-title">Klik untuk memilih file, atau seret file ke sini</div>
                        <div class="small text-muted">Format .xlsx, maksimal 5 MB</div>
                        <div id="fileName" class="mt-2 small">Belum ada file dipilih</div>
                    </div>
                    <input id="fileInput" type="file" name="file" accept=".xlsx" class="d-none" />
                    <div id="fileHint" class="small text-danger mb-2" aria-live="polite"></div>

                    <button id="importBtn" type="submit" class="btn btn-primary" disabled>
                        <span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>
                        Import data
                    </button>
                </form>

                <hr />
                <div class="small text-muted">
                    <div class="fw-semibold mb-1">Aturan file</div>
                    <ul class="mb-0 ps-3">
                        <li>Nama sheet harus <code>@sheetName</code>.</li>
                        <li>Baris pertama berisi kolom: @foreach (var c in columns) { <code class="me-1">@c</code> }</li>
                        <li>Jika sheet atau kolom tidak cocok dengan database, import dibatalkan.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DATA -->
<div class="card shadow-sm">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <span class="fw-semibold">Data lagu <span class="badge text-bg-secondary">@total</span></span>
        <input id="searchBox" type="search" class="form-control form-control-sm w-auto"
               placeholder="Cari judul atau genre..." aria-label="Cari" />
    </div>

    @if (total == 0)
    {
        <div class="card-body text-center text-muted py-5">
            Belum ada data. Import file Excel untuk mengisi tabel ini.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table id="musikTable" class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:4rem">No</th>
                        <th>@Html.DisplayNameFor(m => m.Name)</th>
                        <th>@Html.DisplayNameFor(m => m.Genre)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(no++)</td>
                            <td>@item.Name</td>
                            <td>@item.Genre</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Popup error *@
<div class="modal fade" id="importErrorModal" tabindex="-1" aria-labelledby="importErrorTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="importErrorTitle">Import gagal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(importErrors))
                {
                    <ul class="mb-0">
                        @foreach (var line in importErrors.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <li>@line</li>
                        }
                    </ul>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var zone = document.getElementById('dropzone');
            var input = document.getElementById('fileInput');
            var label = document.getElementById('fileName');
            var hint = document.getElementById('fileHint');
            var btn = document.getElementById('importBtn');
            var form = document.getElementById('importForm');
            var maxBytes = 5 * 1024 * 1024;

            function reset(message) {
                input.value = '';
                label.textContent = 'Belum ada file dipilih';
                hint.textContent = message || '';
                btn.disabled = true;
            }

            function pick(file) {
                if (!file) { reset(); return; }
                if (!file.name.toLowerCase().endsWith('.xlsx')) { reset('Hanya file .xlsx yang didukung.'); return; }
                if (file.size > maxBytes) { reset('Ukuran file maksimal 5 MB.'); return; }
                hint.textContent = '';
                label.textContent = file.name + ' (' + Math.ceil(file.size / 1024) + ' KB)';
                btn.disabled = false;
            }

            zone.addEventListener('click', function () { input.click(); });
            zone.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
            });
            input.addEventListener('change', function () { pick(input.files[0]); });

            ['dragenter', 'dragover'].forEach(function (ev) {
                zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.add('dragover'); });
            });
            ['dragleave', 'drop'].forEach(function (ev) {
                zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.remove('dragover'); });
            });
            zone.addEventListener('drop', function (e) {
                if (e.dataTransfer.files.length) {
                    input.files = e.dataTransfer.files;
                    pick(input.files[0]);
                }
            });

            form.addEventListener('submit', function () {
                btn.disabled = true;
                btn.querySelector('.spinner-border').classList.remove('d-none');
            });

            // Pencarian di tabel (jQuery)
            $('#searchBox').on('input', function () {
                var q = this.value.toLowerCase();
                $('#musikTable tbody tr').each(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(q) > -1);
                });
            });
        })();
    </script>

    @if (!string.IsNullOrEmpty(importErrors))
    {
        <script>
            new bootstrap.Modal(document.getElementById('importErrorModal')).show();
        </script>
    }
}
